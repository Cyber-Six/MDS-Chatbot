# Environment Variables for MDS-Chatbot microservice

# ---- Server Configuration -------------------------------------------------------

CHATBOT_PORT=3005
CHATBOT_HOST=0.0.0.0

# ---- API Key Authentication -----------------------------------------------------
CHATBOT_API_KEY=generated_api_key_here

# ---- Database Configuration -----------------------------------------------------

CHATBOT_DB_HOST=localhost
CHATBOT_DB_PORT=5432
CHATBOT_DB_NAME=mds_chatbot
CHATBOT_DB_USER=mdsadmin
CHATBOT_DB_PASSWORD=db_password_here
CHATBOT_DB_MAX_CONN=5

# ---- LLaMA Server Connection ----------------------------------------------------
# llama-server is managed separately by mdsystem-ai.service

LLAMA_SERVER_HOST=localhost
LLAMA_SERVER_PORT=8080
LLAMA_REQUEST_TIMEOUT=600000
LLAMA_HEALTH_CHECK_TIMEOUT=300000
AUTO_START_LLAMA=false

# ---- Safety Mode ----------------------------------------------------------------
# true = full medical safety pipeline (emergency detection, prohibited topics, response validation)
# false = fast mode, minimal processing

MEDICAL_SAFETY_MODE=false

# ---- Logging --------------------------------------------------------------------

LOG_LEVEL=info
LOGGER_DIR=logs

# ---- Rate Limiting --------------------------------------------------------------
# Patient rate limits (per IP)
PATIENT_RATE_LIMIT_WINDOW_MS=60000
PATIENT_RATE_LIMIT_MAX=20

# Staff rate limits (per IP)
STAFF_RATE_LIMIT_WINDOW_MS=60000
STAFF_RATE_LIMIT_MAX=60

# ---- CORS -----------------------------------------------------------------------
# Comma-separated list of allowed origins (browser requests only)
CORS_ORIGINS=https://www.mdsystemtip.space,https://www2.mdsystemtip.space,https://staff.mdsystemtip.space,https://staff2.mdsystemtip.space
             # Add more origins as needed, separated by commas

